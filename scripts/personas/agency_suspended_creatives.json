  "kpis": [
    {
      "name": "Pitch Win Rate",
      "description": "Percentage of pitches that convert to signed clients",
      "formula": "(pitches_won / pitches_made) * 100",
      "input_fields": ["pitches_won", "pitches_made"],
      "category": "Sales",
      "room": "Outbound & Pitches"
    },
    {
      "name": "Lead-to-Client Conversion Rate",
      "description": "Percentage of qualified leads that become clients",
      "formula": "(new_clients_signed / qualified_leads) * 100",
      "input_fields": ["new_clients_signed", "qualified_leads"],
      "category": "Sales",
      "room": "Business Development"
    },
    {
      "name": "Average Deal Size",
      "description": "Average revenue per new client signed",
      "formula": "new_client_revenue / new_clients_signed",
      "input_fields": ["new_client_revenue", "new_clients_signed"],
      "category": "Sales",
      "room": "Business Development"
    },
    {
      "name": "Cost Per Lead",
      "description": "How much BD spend is needed to generate one qualified lead",
      "formula": "bd_spend / qualified_leads",
      "input_fields": ["bd_spend", "qualified_leads"],
      "category": "Sales",
      "room": "Business Development"
    },
    {
      "name": "Proposal Turnaround Time",
      "description": "Average days to send a proposal after first meeting",
      "formula": "proposal_turnaround_days",
      "input_fields": ["proposal_turnaround_days"],
      "category": "Operations",
      "room": "Outbound & Pitches"
    },

    {
      "name": "Creative Revision Rate",
      "description": "How often clients ask for revisions — high = misaligned briefs or poor quality",
      "formula": "(revisions_requested / deliverables_submitted) * 100",
      "input_fields": ["revisions_requested", "deliverables_submitted"],
      "category": "Operations",
      "room": "Creative"
    },
    {
      "name": "First-Draft Approval Rate",
      "description": "Percentage of deliverables approved on first submission — measures brief-to-output alignment",
      "formula": "(first_draft_approvals / deliverables_submitted) * 100",
      "input_fields": ["first_draft_approvals", "deliverables_submitted"],
      "category": "Operations",
      "room": "Creative"
    },
    {
      "name": "Creative Output per Designer",
      "description": "Average deliverables completed per active designer",
      "formula": "deliverables_completed / designers_active",
      "input_fields": ["deliverables_completed", "designers_active"],
      "category": "Operations",
      "room": "Design Studio"
    },
    {
      "name": "Asset Reuse Rate",
      "description": "How often existing assets are reused vs. creating from scratch — measures efficiency",
      "formula": "(reused_assets / total_assets_created) * 100",
      "input_fields": ["reused_assets", "total_assets_created"],
      "category": "Custom",
      "room": "Creative"
    },
    {
      "name": "Avg Production Time",
      "description": "Average hours spent per deliverable",
      "formula": "avg_production_hours",
      "input_fields": ["avg_production_hours"],
      "category": "Operations",
      "room": "Creative"
    },

    {
      "name": "Client Retention Rate",
      "description": "Percentage of clients retained month-over-month",
      "formula": "(retained_clients / total_clients_som) * 100",
      "input_fields": ["retained_clients", "total_clients_som"],
      "category": "Sales",
      "room": "Client Servicing"
    },
    {
      "name": "Revenue per Client",
      "description": "Average revenue generated per active client",
      "formula": "total_revenue / active_clients",
      "input_fields": ["total_revenue", "active_clients"],
      "category": "Finance",
      "room": "Account Management"
    },
    {
      "name": "Upsell Rate",
      "description": "Percentage of clients who buy additional services",
      "formula": "(upsold_clients / active_clients) * 100",
      "input_fields": ["upsold_clients", "active_clients"],
      "category": "Sales",
      "room": "Client Servicing"
    },
    {
      "name": "SLA Compliance Rate",
      "description": "Percentage of deliveries made on time — slipping SLA = client churn risk",
      "formula": "(on_time_deliveries / total_deliveries) * 100",
      "input_fields": ["on_time_deliveries", "total_deliveries"],
      "category": "Operations",
      "room": "Project Management"
    },
    {
      "name": "Client Response Time",
      "description": "Average hours to respond to client messages — slow = frustration",
      "formula": "avg_response_hours",
      "input_fields": ["avg_response_hours"],
      "category": "Custom",
      "room": "Client Servicing"
    },
    {
      "name": "Client NPS",
      "description": "Net Promoter Score from client surveys",
      "formula": "client_nps",
      "input_fields": ["client_nps"],
      "category": "Custom",
      "room": "Client Servicing"
    },

    {
      "name": "Average Client ROAS",
      "description": "Return on ad spend across all client campaigns",
      "formula": "client_ad_revenue / client_ad_spend",
      "input_fields": ["client_ad_revenue", "client_ad_spend"],
      "category": "Marketing",
      "room": "Paid Media"
    },
    {
      "name": "Campaign On-Time Rate",
      "description": "Percentage of campaigns launched on schedule",
      "formula": "(on_time_launches / total_launches) * 100",
      "input_fields": ["on_time_launches", "total_launches"],
      "category": "Operations",
      "room": "Digital Marketing"
    },
    {
      "name": "SEO Keyword Improvement Rate",
      "description": "Percentage of tracked keywords showing rank improvement",
      "formula": "(keywords_improved / total_keywords_tracked) * 100",
      "input_fields": ["keywords_improved", "total_keywords_tracked"],
      "category": "Marketing",
      "room": "SEO"
    },
    {
      "name": "Social Engagement Rate",
      "description": "Engagement as percentage of total followers",
      "formula": "(social_engagements / social_followers) * 100",
      "input_fields": ["social_engagements", "social_followers"],
      "category": "Marketing",
      "room": "Social Media"
    },
    {
      "name": "Average Cost Per Click",
      "description": "Average CPC across all client paid campaigns",
      "formula": "avg_cpc",
      "input_fields": ["avg_cpc"],
      "category": "Marketing",
      "room": "Paid Media"
    },

    {
      "name": "Brief Completion Rate",
      "description": "Percentage of strategy briefs completed within SLA",
      "formula": "(briefs_completed / briefs_total) * 100",
      "input_fields": ["briefs_completed", "briefs_total"],
      "category": "Operations",
      "room": "Strategy & Planning"
    },
    {
      "name": "Strategy-to-Launch Time",
      "description": "Average days from strategy approval to campaign going live",
      "formula": "strategy_to_launch_days",
      "input_fields": ["strategy_to_launch_days"],
      "category": "Operations",
      "room": "Strategy & Planning"
    },

    {
      "name": "Revenue per Employee",
      "description": "Total revenue divided by headcount — core agency health metric",
      "formula": "total_revenue / total_employees",
      "input_fields": ["total_revenue", "total_employees"],
      "category": "Finance",
      "room": "Finance & Operations"
    },
    {
      "name": "Billable Utilization Rate",
      "description": "Percentage of total hours that are billable — THE most important agency metric most don't track",
      "formula": "(billable_hours / total_hours) * 100",
      "input_fields": ["billable_hours", "total_hours"],
      "category": "Finance",
      "room": "Finance & Operations"
    },
    {
      "name": "Gross Profit Margin",
      "description": "Revenue minus direct costs as percentage of revenue",
      "formula": "((total_revenue - direct_costs) / total_revenue) * 100",
      "input_fields": ["total_revenue", "direct_costs"],
      "category": "Finance",
      "room": "Finance"
    },
    {
      "name": "Invoice Collection Rate",
      "description": "Percentage of invoiced amount actually collected — cash flow killer when low",
      "formula": "(collected_amount / invoiced_amount) * 100",
      "input_fields": ["collected_amount", "invoiced_amount"],
      "category": "Finance",
      "room": "Finance"
    },
    {
      "name": "Employee Attrition Rate",
      "description": "Monthly percentage of employees leaving",
      "formula": "(employees_left / avg_employees) * 100",
      "input_fields": ["employees_left", "avg_employees"],
      "category": "Custom",
      "room": "HR & People"
    },
    {
      "name": "Revenue Concentration Risk",
      "description": "What percentage of revenue comes from your biggest client — above 30% is dangerous",
      "formula": "(top_client_revenue / total_revenue) * 100",
      "input_fields": ["top_client_revenue", "total_revenue"],
      "category": "Custom",
      "room": "Finance"
    },
    {
      "name": "Bench Rate",
      "description": "Percentage of hours that are unbillable — the silent profit killer",
      "formula": "(unbillable_hours / total_hours) * 100",
      "input_fields": ["unbillable_hours", "total_hours"],
      "category": "Custom",
      "room": "Finance & Operations"
    },
    {
      "name": "Training Investment per Employee",
      "description": "Hours invested in upskilling per person — agencies that stop training lose talent",
      "formula": "training_hours / total_employees",
      "input_fields": ["training_hours", "total_employees"],
      "category": "Custom",
      "room": "HR & People"
    }
  ],

