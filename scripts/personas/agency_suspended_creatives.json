        { "name": "Content & Copy", "description": "Copywriting, blogs, social content" },
        { "name": "Video & Motion", "description": "Video production, motion graphics, reels" }
      ]
    },
    {
      "name": "Account Management",
      "description": "Client relationships, delivery, and retention",
