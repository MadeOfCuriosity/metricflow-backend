# ===========================================
# MetricFlow Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Environment (development or production)
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metricflow

# JWT Settings
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Frontend URL (strict in production)
FRONTEND_URL=http://localhost:5173

# Redis (optional - for distributed rate limiting in production)
# REDIS_URL=redis://localhost:6379/0

# Gemini API (recommended - simpler setup)
# Get an API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud AI (alternative - uses mock responses if neither is configured)
# Set up a GCP project and enable Vertex AI API
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Rate Limiting for AI features
AI_RATE_LIMIT_PER_DAY=50

# ===========================================
# Integration OAuth Credentials
# ===========================================

# Encryption key for stored OAuth tokens (Fernet key, 32 url-safe base64 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Google OAuth (shared by Google Sheets, Google Ads, and GA4) ---
# Create an OAuth 2.0 Client (type: Web) in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# In your GCP project, enable these APIs:
#   - Google Sheets API
#   - Google Ads API
#   - Google Analytics Data API
# Add all three redirect URIs below to the "Authorized redirect URIs" list.
# On the OAuth consent screen add these scopes:
#   .../auth/spreadsheets.readonly   (Sheets)
#   .../auth/adwords                 (Google Ads)
#   .../auth/analytics.readonly      (GA4)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/google_sheets/callback
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/google_ads/callback
GA4_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/ga4/callback

# Google Ads developer token (required in addition to OAuth).
# Apply for one in your Google Ads Manager account under
# Tools & Settings > Setup > API Center. Basic access is fine for most agencies;
# test accounts work with a pending token.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Meta (Facebook + Instagram) Ads ---
# Create a Meta app at https://developers.facebook.com/apps/
# Add the "Marketing API" product.
# Under Facebook Login > Settings, add the redirect URI below to "Valid OAuth Redirect URIs".
# App must be in Live mode (or users added as testers) to use ads_read + business_management.
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/meta_ads/callback
META_API_VERSION=v19.0

# --- Zoho OAuth (shared by CRM, Books, Sheet) ---
# Register at https://api-console.zoho.com/ (or the console for your region's
# data center, e.g. https://api-console.zoho.in/) — create a "Server-based
# Application", and add ALL THREE redirect URIs below to it, even if you only
# use one product — Zoho rejects the OAuth callback otherwise ("Invalid
# Redirect Uri").
# ZOHO_OAUTH_CLIENT_ID=
# ZOHO_OAUTH_CLIENT_SECRET=
# ZOHO_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/zoho_crm/callback
# ZOHO_BOOKS_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/zoho_books/callback
# ZOHO_SHEET_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/zoho_sheet/callback
# Data center your Zoho org/client ID is registered in: com (default, US/global),
# in (India), eu, com.au, jp, com.cn. Must match the console you registered in above,
# or the token exchange fails after the user approves access.
# ZOHO_DC=com

# ===========================================
# Razorpay (billing / subscriptions)
# ===========================================
# Dashboard: https://dashboard.razorpay.com
# Use rzp_test_* keys in dev, rzp_live_* in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — configure at Razorpay Dashboard > Settings > Webhooks,
# add URL https://<your-backend>/api/subscriptions/webhook, then copy the secret here.
# Required in production — startup fails if unset.
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated mapping of internal plan_code to Razorpay plan_id, e.g.
#   "starter:plan_ABC,pro:plan_XYZ,enterprise:plan_DEF"
# Create Plans at Dashboard > Subscriptions > Plans first.
RAZORPAY_PLAN_IDS=
